{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "kipora/prices",
	"title": "Price list",
	"category": "kipora",
	"description": "Prices from the calculator settings, so they always match the calculator.",
	"textdomain": "kipora",
	"attributes": {
		"group": {
			"type": "string",
			"default": "grave"
		},
		"title": {
			"type": "string",
			"default": ""
		},
		"note": {
			"type": "string",
			"default": ""
		},
		"buttonText": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"reusable": false
	},
	"icon": "money-alt",
	"render": "file:./render.php"
}