{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "kipora/page-list",
	"title": "Subpage cards",
	"category": "kipora",
	"description": "Cards linking to the subpages of this page (or of another page).",
	"textdomain": "kipora",
	"attributes": {
		"title": {
			"type": "string",
			"default": ""
		},
		"parent": {
			"type": "integer",
			"default": 0
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"reusable": false
	},
	"icon": "excerpt-view",
	"render": "file:./render.php",
	"usesContext": [
		"postId"
	]
}