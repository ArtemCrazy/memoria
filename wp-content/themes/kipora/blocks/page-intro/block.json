{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "kipora/page-intro",
	"title": "Page heading",
	"category": "kipora",
	"description": "Page headline, text, buttons and a photo at the top of an inner page.",
	"textdomain": "kipora",
	"attributes": {
		"title": {
			"type": "string",
			"default": ""
		},
		"lead": {
			"type": "string",
			"default": ""
		},
		"buttonText": {
			"type": "string",
			"default": ""
		},
		"buttonUrl": {
			"type": "string",
			"default": ""
		},
		"preset": {
			"type": "object",
			"default": {}
		},
		"secondText": {
			"type": "string",
			"default": ""
		},
		"secondUrl": {
			"type": "string",
			"default": ""
		},
		"image": {
			"type": "object",
			"default": {}
		},
		"fallback": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"reusable": false,
		"multiple": false
	},
	"icon": "heading",
	"render": "file:./render.php"
}